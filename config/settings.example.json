{
  "lastChangelogVersion": "1.5.0",
  "theme": "catppuccin-mocha",
  "compaction": {
    "enabled": true
  },
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-markdown-preview",
    "npm:pi-mcp-adapter",
    {
      "source": "npm:context-mode",
      "extensions": [
        "-build/adapters/pi/extension.js"
      ],
      "skills": [
        "-skills/context-mode/SKILL.md",
        "-skills/ctx-doctor/SKILL.md",
        "-skills/ctx-index/SKILL.md",
        "-skills/ctx-insight/SKILL.md",
        "-skills/ctx-purge/SKILL.md",
        "-skills/ctx-search/SKILL.md",
        "-skills/ctx-stats/SKILL.md",
        "-skills/ctx-upgrade/SKILL.md"
      ]
    },
    "npm:@narumitw/pi-goal",
    "npm:@juicesharp/rpiv-advisor",
    "npm:@dustydonkey/pi-spinner",
    "npm:@ayulab/pi-rewind",
    "npm:@juicesharp/rpiv-btw",
    "npm:@ff-labs/pi-fff",
    "npm:pi-subagents"
  ],
  "defaultProvider": "routerai",
  "defaultModel": "deepseek/deepseek-v4.1-flash-1017",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "skills": [
    "+skills/find-skills/SKILL.md",
    "-skills/safety-guard"
  ],
  "defaultProjectTrust": "always",
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:@narumitw/pi-goal\",\"scope\":\"user\"}": "0.54.15",
    "{\"source\":\"npm:@dustydonkey/pi-spinner\",\"scope\":\"user\"}": "1.0.2",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.87.0"
  },
  "extensions": [
    "-builtin:mcp",
    "-extensions/safety-guard.ts"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "routerai/~deepseek/deepseek-v4-flash-latest",
        "thinking": "low"
      }
    }
  },
  "showCacheMissNotices": true
}
